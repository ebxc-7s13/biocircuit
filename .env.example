# Development demo is explicit, synthetic and browser-local. For a real backend set connected.
# Hosted staging requires no Docker. Follow docs/CLOUD_SETUP.md before switching modes.
# Keep actual values in ignored .env.local; use a newly designated isolated staging project.
VITE_APP_MODE=demo
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
VITE_HCAPTCHA_SITE_KEY=YOUR_PUBLIC_HCAPTCHA_SITE_KEY
# Server-only Edge Function secrets; configure through Supabase secrets, NEVER prefix with VITE_.
# SUPABASE_URL and SUPABASE_ANON_KEY/SUPABASE_SERVICE_ROLE_KEY are supplied by Edge runtime.
# ALLOWED_ORIGIN=https://YOUR_FRONTEND_DOMAIN
# Local staging instead uses an exact loopback origin such as http://127.0.0.1:5190.
# CROSSREF_MAILTO=YOUR_SERVICE_CONTACT_EMAIL
# AVATAR_PROCESSOR_URL=https://YOUR_FIRST_PARTY_PROCESSOR/avatar
# AVATAR_PROCESSOR_TOKEN=SERVER_ONLY_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS
# NCBI_EMAIL=YOUR_SERVICE_CONTACT_EMAIL
# NCBI_API_KEY=OPTIONAL_SERVER_ONLY_NCBI_KEY (conservative 2 requests/second still applies)
# PROJECT_IMAGE_PROCESSOR_URL=https://YOUR_FIRST_PARTY_PROCESSOR/project-image
