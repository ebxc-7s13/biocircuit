{
  "name": "biocircuit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "lint": "eslint src tests scripts",
    "test": "vitest run",
    "test:db": "node scripts/test-db.mjs",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:db && npm run build",
    "prebuild": "node scripts/check-config.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "test:edge": "deno test --allow-env=ALLOWED_ORIGIN,SUPABASE_URL,SUPABASE_ANON_KEY,SUPABASE_SERVICE_ROLE_KEY,NCBI_API_KEY supabase/functions/http_test.ts supabase/functions/pubmed_test.ts supabase/functions/crossref_test.ts",
    "typecheck:edge": "deno check supabase/functions/scholarly-search/index.ts supabase/functions/account-delete/index.ts supabase/functions/avatar/index.ts supabase/functions/project-images/index.ts",
    "avatar:processor": "node scripts/avatar-processor.mjs",
    "format": "prettier --write src scripts tests supabase/functions *.json *.ts *.js",
    "format:check": "prettier --check src scripts tests supabase/functions *.json *.ts *.js",
    "evaluate:ranking": "node --experimental-strip-types scripts/evaluate-ranking.mjs",
    "test:production": "node scripts/smoke-production.mjs",
    "storage:cleanup": "node scripts/cleanup-storage.mjs",
    "storage:reconcile": "node scripts/storage-reconcile.mjs",
    "recovery:serve": "node scripts/serve-recovery.mjs",
    "recovery:request": "node scripts/request-staging-recovery.mjs",
    "recovery:reset": "node scripts/test-delivered-recovery-staging.mjs",
    "recovery:used-link": "node scripts/test-expired-recovery-staging.mjs --consumed",
    "test:recovery-adoption": "node scripts/test-recovery-adoption-staging.mjs",
    "test:retention-schedule": "node scripts/test-retention-schedule.mjs",
    "cloud:preflight": "node scripts/cloud-preflight.mjs",
    "cloud:plan": "node scripts/cloud-plan.mjs",
    "test:cloud-catalog": "node scripts/test-cloud-catalog.mjs",
    "test:cloud-http": "node scripts/cloud-http.mjs",
    "test:staging-ingress": "node scripts/staging-ingress.mjs",
    "test:staging-browser": "node scripts/test-connected-staging.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "@vitejs/plugin-react": "4.4.1",
    "lucide-react": "0.468.0",
    "motion": "14.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router-dom": "7.18.4",
    "typescript": "5.8.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.5",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "eslint": "10.12.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "supabase": "2.120.0",
    "typescript-eslint": "8.71.1",
    "vite": "6.4.4",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
